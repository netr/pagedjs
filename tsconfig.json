{
	"compilerOptions": {
		"declaration": true,
		"declarationDir": "dist/",
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "es2020",
		"moduleResolution": "bundler",
		"noEmit": true,
		"sourceMap": true,
		"target": "es2020"
	},

	"include": ["src/**/*.ts"]
}
